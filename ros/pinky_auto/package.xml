<?xml version="1.0"?>
<package format="3">
  <name>pinky_auto</name>
  <version>0.1.0</version>
  <description>Pinky Pro autonomous driving: guarded motor driver, mapping, Nav2 navigation and waypoint patrol</description>
  <maintainer email="pinky@example.com">pinky</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>pinky_bringup</exec_depend>
  <exec_depend>pinky_description</exec_depend>
  <exec_depend>pinky_navigation</exec_depend>
  <exec_depend>pinky_sensor_adc</exec_depend>
  <exec_depend>sllidar_ros2</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
