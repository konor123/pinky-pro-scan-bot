<?xml version="1.0"?>
<package format="3">
  <name>scan3d_sim</name>
  <version>0.1.0</version>
  <description>Gazebo scan test for the Pinky Pro 3D scan bot: D455 side-mount robot, marker-board world, simulation agent</description>
  <maintainer email="pinky@example.com">pinky</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>scan3d_robot</exec_depend>
  <exec_depend>pinky_description</exec_depend>
  <exec_depend>pinky_gz_sim</exec_depend>
  <exec_depend>pinky_sim_examples</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
