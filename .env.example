# 로봇 주소. 이 파일을 .env로 복사해 채운다(.env는 커밋하지 않는다).
# Docker(docker/compose.yaml)와 scripts/ssh_aliases.sh, scan3d.config가 .env를 읽는다.

# 로봇 SSH 사용자
PINKY_USER=pinky

# 로봇 AP 이름(로봇 LCD에 나옴). scripts/ssh_aliases.sh가 같은 Wi-Fi에서 이 이름으로 주소를 찾아 아래 HOST를 채운다
# 로봇 1 = H(카메라 높게), 로봇 2 = L(카메라 낮게)
PINKY1_SSID=pinky_d52c
PINKY2_SSID=pinky_6437

# 로봇 주소(IP 또는 호스트 이름). SSID를 쓰면 비워 둔다
PINKY1_HOST=
PINKY2_HOST=

# 로봇에 등록한 SSH 키가 기본 키(~/.ssh/id_ed25519 등)가 아닐 때 그 경로. scripts/ssh_aliases.sh가 별칭에 넣는다(Docker는 SSH 에이전트를 쓰므로 무시)
PINKY_KEY=

# tools/upload.sh가 보낼 곳(필요하면 채움)
SCAN3D_UPLOAD=
